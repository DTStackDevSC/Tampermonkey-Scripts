<Window x:Class="GitHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GitHelper.App.Controls"
        xmlns:vm="clr-namespace:GitHelper.ViewModels;assembly=GitHelper.ViewModels"
        xmlns:core="clr-namespace:GitHelper.Core;assembly=GitHelper.Core"
        Title="Git Helper" Width="1200" Height="800" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="app.ico">
    <Window.Resources>
        <!-- A disabled button still shows its tooltip, which says why it is off. -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- Top bar: which repository -->
        <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Vertical" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding RepoPath}" Style="{StaticResource HintText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding RecentRepos}" SelectedItem="{Binding SelectedRecent}" Width="260" Margin="0,0,8,0"
                              ToolTip="Repositories you opened before: pick one to switch to it"/>
                    <Button Content="📁 Open repo" Command="{Binding OpenRepoCommand}" ToolTip="Pick a folder inside a git repository on this PC"/>
                    <Button Content="⬇ Clone" Command="{Binding CloneCommand}" ToolTip="Copy a repository from GitHub to this PC"/>
                    <Button Content="⚙ Settings" Command="{Binding SettingsCommand}" ToolTip="Your commit name and email, and how Pull works"/>
                    <Button Content="? Help" Command="{Binding HelpCommand}" Margin="0" ToolTip="What every button does"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bottom: result of the last action, and the git output -->
        <Border DockPanel.Dock="Bottom" Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                <Expander Header="Output (git commands and their answers)" Margin="0,6,0,0">
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearOutputCommand}" VerticalAlignment="Top" Margin="8,0,0,0"
                                ToolTip="Empty the output panel"/>
                        <TextBox x:Name="OutputBox" Text="{Binding OutputText, Mode=OneWay}" IsReadOnly="True" Height="160"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Expander>
            </StackPanel>
        </Border>

        <Grid>
            <DockPanel Margin="16,12">
                <!-- Branch, sync, identity, GitHub account -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="🌿 Branch" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" MinWidth="200" Margin="0,0,12,0"
                                      IsEnabled="{Binding HasRepo}" ToolTip="Pick a branch to switch to it"/>
                            <TextBox Text="{Binding NewBranchName, UpdateSourceTrigger=PropertyChanged}" Width="170" Margin="0,0,8,0"
                                     ToolTip="Name of a new branch, for example fix/login-button"/>
                            <Button Content="＋ New branch" Command="{Binding CreateBranchCommand}"
                                    ToolTip="Create a branch with the name on the left and switch to it"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{Binding SyncText}" Foreground="{Binding SyncKind, Converter={StaticResource StatusBrush}}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding IdentityText}" TextWrapping="Wrap" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IdentityWarning}" Value="True">
                                                <Setter Property="Foreground" Value="#B26A00"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding GhText}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="🔑 Sign in to GitHub" Command="{Binding SignInCommand}" Padding="8,2"
                                        Visibility="{Binding ShowSignIn, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Opens the GitHub sign in (gh auth login) in a small window"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Actions with GitHub -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <WrapPanel>
                        <Button Content="🔁 Refresh" Command="{Binding RefreshCommand}" ToolTip="Read the folder again"/>
                        <Button Content="🔍 Check GitHub" Command="{Binding FetchCommand}" ToolTip="See if GitHub has new commits, without changing your files (git fetch)"/>
                        <Button Content="⬇ Pull" Command="{Binding PullCommand}" ToolTip="Bring the new commits from GitHub into this folder"/>
                        <Button Content="⬆ Push" Command="{Binding PushCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0"
                                ToolTip="Send your commits to GitHub"/>
                        <Button Content="⟳ Sync" Command="{Binding SyncCommand}" ToolTip="Pull, then Push"/>
                        <Button Content="🌐 Open on GitHub" Command="{Binding OpenOnGitHubCommand}" ToolTip="Open this repository in your browser (needs a GitHub remote)"/>
                        <Button Content="📂 Show in Explorer" Command="{Binding OpenInExplorerCommand}" ToolTip="Open the folder in Windows Explorer"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding PushHint}" Style="{StaticResource HintText}" Margin="0,4,0,0"
                               Visibility="{Binding PushHint, Converter={StaticResource EmptyToVis}}"/>
                </StackPanel>

                <!-- A pull or merge stopped halfway -->
                <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="12,8" CornerRadius="6" Background="#FFF4CE" BorderBrush="#E0B000" BorderThickness="1"
                        Visibility="{Binding ShowOperation, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Continue" Command="{Binding ContinueCommand}"
                                    Visibility="{Binding CanContinue, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Go on once every file marked ! is fixed and saved"/>
                            <Button Content="{Binding AbortText}" Command="{Binding AbortCommand}" Margin="0"
                                    ToolTip="Go back to how things were before. Needs a second click."/>
                        </StackPanel>
                        <TextBlock Text="{Binding OperationText}" Foreground="#5C4400" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </DockPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" MinWidth="280"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Changes and commit -->
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Commit message" Style="{StaticResource CardTitle}"/>
                                <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="64" MaxHeight="140" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding HasRepo}"
                                         ToolTip="First line: what you changed, short. Add more lines below if needed."/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="✔ Commit" Command="{Binding CommitCommand}" ToolTip="Save the ticked files as one commit on this PC"/>
                                    <Button Content="✔ Commit and push" Command="{Binding CommitAndPushCommand}" Style="{DynamicResource AccentButtonStyle}"
                                            ToolTip="Commit the ticked files and send them to GitHub"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding CommitHint}" Style="{StaticResource HintText}" Margin="0,6,0,0"
                                           Visibility="{Binding CommitHint, Converter={StaticResource EmptyToVis}}"/>
                            </StackPanel>
                        </Border>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="{Binding DiscardText}" Command="{Binding DiscardCommand}" Margin="0" Padding="8,2"
                                    ToolTip="Throw away your changes to the selected file. Needs a second click."/>
                            <CheckBox IsChecked="{Binding AllChecked}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Tick or untick every file"/>
                            <TextBlock Text="{Binding FilesHeader}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DiscardHint}" Style="{StaticResource HintText}" Margin="0,0,0,4"
                                   Visibility="{Binding DiscardHint, Converter={StaticResource EmptyToVis}}"/>
                        <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FileItem}">
                                    <DockPanel ToolTip="{Binding KindText}">
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Border DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#667EEA"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Badge}" Value="?"><Setter Property="Background" Value="#1E8E3E"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Badge}" Value="A"><Setter Property="Background" Value="#1E8E3E"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Badge}" Value="D"><Setter Property="Background" Value="#C62828"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Badge}" Value="!"><Setter Property="Background" Value="#E08A00"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Badge}" Foreground="White" FontWeight="Bold" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource HintText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Folder, Converter={StaticResource EmptyToVis}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

                    <!-- What changed, and history -->
                    <TabControl Grid.Column="2">
                        <TabItem Header="What changed">
                            <Grid>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding DiffTitle}" Style="{StaticResource HintText}" Margin="4,6,4,6"/>
                                    <ListBox ItemsSource="{Binding DiffLines}" FontFamily="Consolas" FontSize="12"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="MinHeight" Value="0"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type core:DiffLine}">
                                                <Border Background="{Binding Kind, Converter={StaticResource DiffBrush}}" Padding="6,0">
                                                    <TextBlock Text="{Binding Text}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <c:BusyOverlay IsActive="{Binding IsDiffBusy}" Text="Loading the changes…"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="History">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,8,4,8">
                                    <Button Content="{Binding UndoText}" Command="{Binding UndoLastCommitCommand}"
                                            ToolTip="Take back the last commit if it is not on GitHub yet. Needs a second click."/>
                                    <TextBlock Text="{Binding UndoHint}" Style="{StaticResource HintText}" VerticalAlignment="Center"
                                               Visibility="{Binding UndoHint, Converter={StaticResource EmptyToVis}}"/>
                                </StackPanel>
                                <ListView ItemsSource="{Binding Commits}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="" Width="34">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="↑" FontWeight="Bold" Foreground="#B26A00" ToolTip="Not on GitHub yet"
                                                                   Visibility="{Binding Unpushed, Converter={StaticResource BoolToVis}}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Commit" Width="80" DisplayMemberBinding="{Binding Hash}"/>
                                            <GridViewColumn Header="Message" Width="380" DisplayMemberBinding="{Binding Subject}"/>
                                            <GridViewColumn Header="Author" Width="150" DisplayMemberBinding="{Binding Author}"/>
                                            <GridViewColumn Header="When" Width="120" DisplayMemberBinding="{Binding When}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </DockPanel>
            <c:BusyOverlay IsActive="{Binding IsBusy}" Text="{Binding BusyText}"/>
        </Grid>
    </DockPanel>
</Window>

<Window x:Class="GitHelper.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GitHelper.App.Controls"
        Title="Settings" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- A disabled button still shows its tooltip, which says why it is off. -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <StackPanel Margin="20,16">
            <TextBlock Text="Commit identity" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                       Text="The name and email shown on your commits on GitHub. Use your GitHub noreply email so your work email is never published."/>
            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding IdentityName, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding IdentityEmail, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="🐙 Fill from my GitHub account" Command="{Binding FillFromGitHubCommand}"
                        ToolTip="Uses your GitHub login and private noreply email (needs the GitHub sign in)"/>
            </StackPanel>
            <CheckBox IsChecked="{Binding CheckIdentity}" Margin="0,12,0,0"
                      Content="Check before each commit and offer to fix a repository that would use another name or email"/>

            <TextBlock Text="Pull" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0"/>
            <CheckBox IsChecked="{Binding PullRebase}" Margin="0,8,0,0"
                      Content="Pull with rebase (recommended: your local commits go on top, no merge commits)"/>
            <CheckBox IsChecked="{Binding PullAppRepoOnStart}" Margin="0,8,0,0"
                      Content="Update the repository this app runs from each time the app starts (pull)"/>
            <TextBlock Text="{Binding Location}" Style="{StaticResource HintText}" Margin="0,16,0,0"/>

            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,14,0,0" FontWeight="SemiBold"
                       Foreground="{Binding MessageKind, Converter={StaticResource StatusBrush}}"
                       Visibility="{Binding Message, Converter={StaticResource EmptyToVis}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"/>
                <Button Content="💾 Save" Command="{Binding SaveCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
        <c:BusyOverlay IsActive="{Binding IsBusy}" Text="Asking GitHub for your account…"/>
    </Grid>
</Window>

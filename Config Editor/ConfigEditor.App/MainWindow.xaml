<Window x:Class="ConfigEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ConfigEditor.App.Controls"
        xmlns:vm="clr-namespace:ConfigEditor.ViewModels;assembly=ConfigEditor.ViewModels"
        Title="Config Editor" Width="1180" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="app.ico">
    <Window.Resources>
        <CollectionViewSource x:Key="NavView" Source="{Binding Nav}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Vertical">
                    <TextBlock Text="Config Editor" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource HintText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="⟳ Open latest" Command="{Binding OpenLatestCommand}" Margin="0,0,8,0"
                            ToolTip="Download the newest scripts from GitHub"/>
                    <Button Content="📁 Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0"
                            ToolTip="Work on a folder that holds 'Standalone Scripts' and 'Toolbar Scripts'"/>
                    <Button Content="⚙ Settings" Command="{Binding OpenSettingsCommand}" Margin="0,0,8,0" ToolTip="Publishing to GitHub and your token"/>
                    <Button Content="? Help" Command="{Binding OpenHelpCommand}" ToolTip="How to use the app and what each section changes"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bottom bar -->
        <Border DockPanel.Dock="Bottom" Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="🚀 Publish" Command="{Binding PublishCommand}" Margin="0,0,8,0"
                            Visibility="{Binding ShowPublish, Converter={StaticResource BoolToVis}}"
                            ToolTip="Commit your changes to GitHub in one step"/>
                    <Button Content="💾 Save" Command="{Binding SaveCommand}" Style="{DynamicResource AccentButtonStyle}"
                            ToolTip="Write the updated scripts to a folder, then upload them on GitHub"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding UnsavedText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
            </DockPanel>
        </Border>

        <!-- Left navigation -->
        <ListBox DockPanel.Dock="Left" Width="260" ItemsSource="{Binding Source={StaticResource NavView}}"
                 SelectedItem="{Binding SelectedNav}" BorderThickness="0,0,1,0"
                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="8,12,0,4" Opacity="0.75"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                    <Setter Property="ToolTip" Value="{Binding UnavailableReason}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NavItem}">
                    <TextBlock Text="{Binding Title}" Margin="8,4"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Right pane -->
        <Grid>
            <DockPanel Margin="20,14">
                <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12,8" CornerRadius="6"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="{Binding ShowTeamPicker, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Team" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding Teams}" SelectedValuePath="Key" DisplayMemberPath="Label"
                                  SelectedValue="{Binding SelectedTeamKey}" MinWidth="220" Margin="0,0,12,0"/>
                        <Button Content="＋ Add team" Command="{Binding AddTeamCommand}" Margin="0,0,8,0"
                                ToolTip="Create a team in every helper, copied from an existing one"/>
                        <Button Content="{Binding DeleteTeamText}" Command="{Binding DeleteTeamCommand}"
                                ToolTip="Removes the team from every helper. Needs a second click."/>
                    </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedNav.Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <ContentControl Content="{Binding SelectedNav.Page}"/>
                    <TextBlock Text="Pick a section on the left to edit it." Style="{StaticResource HintText}"
                               Visibility="{Binding SelectedNav.Page, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                </Grid>
            </DockPanel>
            <c:BusyOverlay IsActive="{Binding IsBusy}" Text="{Binding BusyText}"/>
        </Grid>
    </DockPanel>
</Window>

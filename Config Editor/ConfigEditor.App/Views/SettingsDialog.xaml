<Window x:Class="ConfigEditor.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <CheckBox Content="Publish to GitHub from this app" IsChecked="{Binding PublishEnabled}" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource HintText}" Margin="28,2,0,14"
                   Text="Off: Save writes the files and you upload them on the GitHub page. On: a Publish button commits them for you."/>
        <TextBlock Text="GitHub token" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <PasswordBox x:Name="TokenBox" PasswordChanged="TokenBox_PasswordChanged"/>
        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,8"
                   Text="A fine grained token with access to DTStackDevSC/Tampermonkey-Scripts and Contents: Read and write. It is stored encrypted for your Windows user. Commits use your private noreply email."/>
        <StackPanel Orientation="Horizontal">
            <Button Content="🔑 Test token" Command="{Binding TestTokenCommand}" Margin="0,0,8,0"/>
            <Button Content="Create a token on GitHub" Click="CreateToken_Click"/>
        </StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding Message, Converter={StaticResource NullToVis}}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Save settings" Command="{Binding SaveCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

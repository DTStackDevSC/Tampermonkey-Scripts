<Window x:Class="ConfigEditor.App.Views.NewTeamDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a team" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Team name" FontWeight="SemiBold"/>
        <TextBox x:Name="NameBox" Margin="0,4,0,2" TextChanged="Input_Changed"/>
        <TextBlock Text="For example: Iberia Team" Style="{StaticResource HintText}" Margin="0,0,0,10"/>
        <TextBlock Text="Short label" FontWeight="SemiBold"/>
        <TextBox x:Name="ShortBox" Margin="0,4,0,2" TextChanged="Input_Changed"/>
        <TextBlock Text="Shown in the team pickers, for example: IBERIA" Style="{StaticResource HintText}" Margin="0,0,0,10"/>
        <TextBlock Text="Copy texts and options from" FontWeight="SemiBold"/>
        <ComboBox x:Name="CopyBox" DisplayMemberPath="Label" Margin="0,4,0,10"/>
        <TextBlock x:Name="Hint" Style="{StaticResource HintText}" Text="Fill in the name and the short label to add the team."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="AddBtn" Content="＋ Add team" IsDefault="True" IsEnabled="False" Click="Add_Click"
                    Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

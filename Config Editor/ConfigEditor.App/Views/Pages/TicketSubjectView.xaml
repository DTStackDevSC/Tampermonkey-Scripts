<UserControl x:Class="ConfigEditor.App.Views.Pages.TicketSubjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ConfigEditor.App.Controls">
    <Grid>
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource HintText}" Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,0,12,12">
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="🏢 Member firms" Style="{StaticResource CardTitle}"/><TextBlock Text="Shown as is the dropdown text, Stored value is the code used in the subject and in the tenant groups below." Style="{StaticResource HintText}" Margin="0,0,0,6"/><c:ListEditor DataContext="{Binding MfOptions}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="📦 Products" Style="{StaticResource CardTitle}"/><TextBlock Text="The first entry is the empty choice shown before picking." Style="{StaticResource HintText}" Margin="0,0,0,6"/><c:ListEditor DataContext="{Binding ProductOptions}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="🔗 Netskope tenants" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Which tenant each member firm uses. Write the member firm codes separated by commas. The five tenants are fixed." Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding TenantGroups}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserSortColumns="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tenant" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                <DataGridTextColumn Header="Member firms (comma separated)" Binding="{Binding Mfs, UpdateSourceTrigger=LostFocus}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

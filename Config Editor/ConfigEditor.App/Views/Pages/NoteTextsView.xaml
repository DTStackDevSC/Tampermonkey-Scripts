<UserControl x:Class="ConfigEditor.App.Views.Pages.NoteTextsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ConfigEditor.App.Controls">
    <Grid>
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource HintText}" Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,0,12,12">
                <TextBlock Text="The texts the Change Tracker writes into the ticket for each kind of entry. The entry details are added below them automatically." Style="{StaticResource HintText}" Margin="0,0,0,12"/>
                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding EntryType}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Work note heading (internal)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding WorkNoteHeader, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    <TextBlock Text="Comment heading (the requester sees it)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding CommentsHeader, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    <TextBlock Text="Comment closing sentence (optional)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding CommentsCloser, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

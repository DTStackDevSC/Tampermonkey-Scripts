<UserControl x:Class="ConfigEditor.App.Views.Pages.ShortDescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ConfigEditor.App.Controls">
    <Grid>
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource HintText}" Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,0,12,12">
                <TextBlock Text="What the Short Description Helper offers this team. Changes show in the ticket dropdowns after the update." Style="{StaticResource HintText}" Margin="0,0,0,12"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="⚙️ General" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Team name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxWidth="420" HorizontalAlignment="Left" MinWidth="300"/>
                        <CheckBox Content="Show the Vendor field" IsChecked="{Binding ShowVendor}" Margin="0,10,0,0"/>
                        <CheckBox Content="Show the PER field" IsChecked="{Binding ShowPER}" Margin="0,4,0,0"/>
                        <TextBlock Text="Complexity note (shown under the complexity dropdown)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ComplexityNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="🏢 Member firms" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Shown as is the text in the dropdown, Stored value is the code written in the short description." Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                        <c:ListEditor DataContext="{Binding MfOptions}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="📦 Products" Style="{StaticResource CardTitle}"/><c:ListEditor DataContext="{Binding ProductOptions}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="🚦 Statuses" Style="{StaticResource CardTitle}"/><c:ListEditor DataContext="{Binding StatusOptions}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="🏷️ Types" Style="{StaticResource CardTitle}"/><c:ListEditor DataContext="{Binding TypeOptions}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="📊 Complexities" Style="{StaticResource CardTitle}"/><c:ListEditor DataContext="{Binding ComplexityOptions}"/></StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

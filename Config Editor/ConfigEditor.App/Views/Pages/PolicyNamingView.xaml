<UserControl x:Class="ConfigEditor.App.Views.Pages.PolicyNamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ConfigEditor.App.Controls">
    <Grid>
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource HintText}" Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,0,12,12">
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="🌍 Regions (GEO)" Style="{StaticResource CardTitle}"/><TextBlock Text="Code goes into the policy name, Shown as is the text in the dropdown." Style="{StaticResource HintText}" Margin="0,0,0,6"/><c:ListEditor DataContext="{Binding Geos}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="🛡️ Policy types" Style="{StaticResource CardTitle}"/><TextBlock Text="Options for the web, CASB and threat policy names." Style="{StaticResource HintText}" Margin="0,0,0,6"/><c:ListEditor DataContext="{Binding PolicyTypes}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="🔒 DLP policy types" Style="{StaticResource CardTitle}"/><TextBlock Text="Options for DLP policy names." Style="{StaticResource HintText}" Margin="0,0,0,6"/><c:ListEditor DataContext="{Binding DlpPolicyTypes}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="👥 Applies to" Style="{StaticResource CardTitle}"/><TextBlock Text="Who the policy is for." Style="{StaticResource HintText}" Margin="0,0,0,6"/><c:ListEditor DataContext="{Binding AppliesTo}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="📡 Channel types" Style="{StaticResource CardTitle}"/><TextBlock Text="Channel letters used in DLP policy names." Style="{StaticResource HintText}" Margin="0,0,0,6"/><c:ListEditor DataContext="{Binding PolicyChannelTypes}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="🎯 DLP criteria" Style="{StaticResource CardTitle}"/><TextBlock Text="Criteria codes for DLP policy names." Style="{StaticResource HintText}" Margin="0,0,0,6"/><c:ListEditor DataContext="{Binding DlpCriteria}"/></StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

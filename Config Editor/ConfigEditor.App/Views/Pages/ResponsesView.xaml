<UserControl x:Class="ConfigEditor.App.Views.Pages.ResponsesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ConfigEditor.App.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <CollectionViewSource x:Key="Grouped" Source="{Binding Items.Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid>
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource HintText}" Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}"/>
        <Grid Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6" DataContext="{Binding Items}">
                    <Button Content="＋ New" Command="{Binding AddCommand}" Margin="0,0,6,4" ToolTip="Add a response below the selected one"/>
                    <Button Content="📄 Copy" Command="{Binding DuplicateCommand}" Margin="0,0,6,4" ToolTip="Copy the selected response"/>
                    <Button Content="⬆" Command="{Binding MoveUpCommand}" Margin="0,0,6,4" ToolTip="Move up in the menu"/>
                    <Button Content="⬇" Command="{Binding MoveDownCommand}" Margin="0,0,6,4" ToolTip="Move down in the menu"/>
                    <Button Content="{Binding RemoveText}" Command="{Binding RemoveCommand}" Margin="0,0,0,4" ToolTip="Delete the selected response. Needs a second click."/>
                </WrapPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Items.Message}" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                <ListBox ItemsSource="{Binding Source={StaticResource Grouped}}" SelectedItem="{Binding Items.Selected}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{Binding Name}" FontWeight="Bold" Opacity="0.75" Margin="4,10,0,2"/></DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="  ↳ " Visibility="{Binding Parent, Converter={StaticResource NullToVis}}" Opacity="0.6"/>
                                <TextBlock Text="{Binding Label}"/>
                                <TextBlock Text="  (hidden)" Opacity="0.55" Visibility="{Binding Enabled, Converter={StaticResource InverseBoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding Items.Selected}" Margin="0,0,12,12"
                            Visibility="{Binding Converter={StaticResource NullToVis}}">
                    <TextBlock Text="Menu text" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"/>
                    <WrapPanel Margin="0,4,0,0">
                        <StackPanel Margin="0,0,16,0" MinWidth="200">
                            <TextBlock Text="Section" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding DataContext.SectionChoices, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Category}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0" MinWidth="240">
                            <TextBlock Text="Writes into" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding DataContext.FieldTypeChoices, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FieldType}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0" MinWidth="200">
                            <TextBlock Text="Inside the submenu of" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding DataContext.ParentChoices, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Parent}"/>
                        </StackPanel>
                        <StackPanel MinWidth="200">
                            <TextBlock Text="Status after inserting" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding DataContext.StatusChoices, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding StatusAfter}"/>
                        </StackPanel>
                    </WrapPanel>
                    <CheckBox Content="Shown in the menu" IsChecked="{Binding Enabled}" Margin="0,10,0,0"/>
                    <CheckBox Content="Opens a submenu (other responses can sit inside it)" IsChecked="{Binding HasSubmenu}" Margin="0,4,0,0"/>
                    <TextBlock Text="Text" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,4"
                               Text="{Binding DataContext.PlaceholderHint, ElementName=Root}"/>
                    <Border Padding="8" CornerRadius="4" Margin="0,0,0,6" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            Visibility="{Binding BodyReadOnly, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ReadOnlyNote}" TextWrapping="Wrap"/>
                    </Border>
                    <c:TemplateEditor Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding BodyReadOnly}"/>
                    <TextBlock Text="👀 Preview (as Jane Doe on a Request)" Style="{StaticResource FieldLabel}"/>
                    <Border Padding="10" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

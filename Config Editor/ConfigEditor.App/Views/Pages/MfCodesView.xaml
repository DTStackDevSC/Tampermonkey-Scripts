<UserControl x:Class="ConfigEditor.App.Views.Pages.MfCodesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ConfigEditor.App.Controls">
    <Grid>
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource HintText}" Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,0,12,12">
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="🏢 Member firm codes" Style="{StaticResource CardTitle}"/><TextBlock Text="The Ticket Assignment Tool reads the member firm name from the ticket and uses this code to pick the group." Style="{StaticResource HintText}" Margin="0,0,0,6"/><c:ListEditor DataContext="{Binding Entries}"/></StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

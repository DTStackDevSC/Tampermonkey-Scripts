<Window x:Class="ConfigEditor.App.Views.SaveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ConfigEditor.App.Controls"
        Title="{Binding Title}" Width="640" Height="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <DockPanel Margin="20">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Style="{DynamicResource AccentButtonStyle}"
                        Margin="0,0,8,0" Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Close" Command="{Binding CloseCommand}" IsCancel="True"/>
            </StackPanel>

            <!-- Review -->
            <DockPanel Visibility="{Binding IsDone, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock DockPanel.Dock="Top" Text="{Binding Destination}" Style="{StaticResource HintText}" Margin="0,0,0,12"/>
                <TextBlock DockPanel.Dock="Top" Text="What's new (shown to users in the changelog). You can reword each line:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Bullets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Tool}" Style="{StaticResource HintText}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Result -->
            <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,14"/>
                <ItemsControl ItemsSource="{Binding Links}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}" HorizontalAlignment="Left" Margin="0,0,0,8"
                                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Url}" ToolTip="{Binding Url}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Visibility="{Binding ShowEmailReminder, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0" Padding="12"
                        CornerRadius="6" Background="#FFF7E6" BorderBrush="#F0C36D" BorderThickness="1">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#333">
                            The repository is public. Before uploading, make sure GitHub hides your email: in Settings &gt; Emails turn on
                            "Keep my email addresses private" and "Block command line pushes that expose my email".
                        </TextBlock>
                        <Button Content="Open GitHub email settings" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/settings/emails"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
        <c:BusyOverlay IsActive="{Binding IsBusy}" Text="{Binding BusyText}"/>
    </Grid>
</Window>

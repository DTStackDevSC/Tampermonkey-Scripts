<UserControl x:Class="ConfigEditor.App.Controls.TemplateEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBox x:Name="Box" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 MinHeight="160" FontFamily="Consolas, Cascadia Mono, Segoe UI" PreviewTextInput="OnTextInput"
                 TextChanged="OnBoxChanged" PreviewKeyDown="OnBoxKey"/>
        <Popup x:Name="Picker" PlacementTarget="{Binding ElementName=Box}" Placement="RelativePoint" StaysOpen="False">
            <Border Padding="4" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Insert a placeholder" Style="{StaticResource HintText}" Margin="4,0,4,4"/>
                    <ListBox x:Name="Options" MouseUp="OnPick" KeyDown="OnPickKey" MinWidth="200"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

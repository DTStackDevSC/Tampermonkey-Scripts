<UserControl x:Class="ConfigEditor.App.Controls.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Cursor="Wait">
    <!-- Blocks clicks at once; the wheel and label fade in after 150 ms so quick waits do not flicker. -->
    <Grid Background="#B3FFFFFF">
        <StackPanel x:Name="Inner" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
            <Grid Width="40" Height="40" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><RotateTransform x:Name="Spin"/></Grid.RenderTransform>
                <Ellipse Stroke="#D0D4F5" StrokeThickness="4"/>
                <Path Stroke="#667EEA" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 20,2 A 18,18 0 0 1 38,20"/>
            </Grid>
            <TextBlock x:Name="Label" Margin="0,10,0,0" Foreground="#333" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
        </StackPanel>
    </Grid>
</UserControl>
